# Copy to .env in the repository root. Never use a VITE_ prefix for secrets.
CQA_DB_PATH=data/cqa.sqlite3
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# DeepSeek uses JSON mode with server-side schema and evidence validation.
LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
LLM_TIMEOUT_SECONDS=150
LLM_MAX_OUTPUT_TOKENS=12000
STT_MODEL=elevenlabs/scribe-v2
DECISION_MODEL=typesafe/jev-1.14
CQA_ENV=development
# Generate with: python -m cqa.admin (never put the plaintext password here).
CQA_PASSWORD_HASH=
CQA_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
CQA_SESSION_HOURS=8
CQA_PAID_PER_HOUR=60
